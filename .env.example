# Copy to .env.local and fill in. Never commit .env.local. See docs/SETUP.md for where each value comes from.

# --- Tiger Data (Postgres + TimescaleDB) ---
# Local:  postgres://postgres:docket@localhost:5432/docket   (npm run db:up)
# Cloud:  connection string from your Tiger Cloud service (includes ?sslmode=require)
DATABASE_URL=postgres://postgres:docket@localhost:5432/docket

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free tier is 5 requests/min per model; these take over when the primary is rate-limited.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_THINKING=LOW

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Optional: voice for read-outs (default is a stock multilingual voice)
ELEVENLABS_VOICE_ID=

# Credit protection (see src/lib/voice/budget.ts). Keep voice OFF while building other features.
VOICE_ENABLED=false
# Calls are refused once the account balance would drop below this. Lower it on demo day.
ELEVENLABS_RESERVE_CREDITS=10000
ELEVENLABS_MAX_SESSIONS_PER_DAY=20

# Shared secret the ElevenLabs agent sends to our server tools (x-docket-tool-secret header). Any long random string.
DOCKET_TOOL_SECRET=

# --- Solana (DEVNET ONLY) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Generated by `npm run solana:keygen` (writes it here for you)
SOLANA_SECRET_KEY=
